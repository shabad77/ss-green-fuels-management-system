generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  ACCOUNTANT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String
  village   String
  gst       String?
  createdAt DateTime @default(now())
  purchases Purchase[]
}

model Vehicle {
  id            Int      @id @default(autoincrement())
  vehicleNumber String   @unique
  ownerName     String
  vehicleType   String
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  purchases Purchase[]
}

model Purchase {
  id         Int      @id @default(autoincrement())

  supplierId Int
  vehicleId  Int

  material   String
  quantity   Float

  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Buyer {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String
  address   String
  gst       String?
  createdAt DateTime @default(now())

  sales Sale[]
}

model Sale {
  id            Int      @id @default(autoincrement())

  buyerId       Int

  invoiceNo     String   @unique

  invoiceDate   DateTime

  vehicleNo     String

  ewayBillNo    String?

  shipToAddress String?

  itemName      String?

  hsnCode       String?

  unit          String?

  quantity      Float

  rate          Float

  amount        Float

  gstPercent    Float

  gstAmount     Float

  total         Float

  createdAt     DateTime @default(now())

  buyer Buyer @relation(fields: [buyerId], references: [id])
}


model Company {
  id                  Int      @id @default(1)

  companyName         String
  gstNumber           String
  panNumber           String?
  address             String
  city                String
  state               String
  pincode             String

  phone               String?
  email               String?
  website             String?

  bankName            String?
  accountName         String?
  accountNumber       String?
  ifscCode            String?
  branch              String?

  upiId               String?

  logo                String?
  signature           String?

  terms               String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}