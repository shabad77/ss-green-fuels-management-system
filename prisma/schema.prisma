generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  mobile    String
  village   String
  gst       String?
  createdAt DateTime @default(now())
  purchases Purchase[]
}

model Vehicle {
  id            Int      @id @default(autoincrement())
  vehicleNumber String   @unique
  ownerName     String
  vehicleType   String
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  purchases Purchase[]
}

model Purchase {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  vehicleId    Int

  material     String
  quantity     Float

  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}